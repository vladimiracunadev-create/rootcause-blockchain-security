node_modules/
data/*.json
data/*.tmp
.env
.DS_Store
coverage/
*.log

# Artefactos de empaquetado de Windows: se generan, no se versionan.
build/
packaging/windows/rootcause.ico

# La landing reutiliza las capturas de docs/img: el workflow de Pages las copia
# al ensamblar el sitio, en vez de versionarlas dos veces.
landing/img/

# La muestra del producto (diapositivas y pauta del expositor) se genera desde
# docs/presentacion.md en cada publicacion: el HTML y los PDF son artefactos.
presentacion/

# La documentacion del sistema se genera desde docs/system-documentation/*.md
# con `node scripts/build-system-docs.js`. Los PDF pesan varios megas y se
# rehacen enteros en cada cambio del texto: son artefactos, no fuentes.
docs/system-documentation/pdf/*.pdf
docs/system-documentation/pdf/*.html
