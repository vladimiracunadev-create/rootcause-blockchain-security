HOST=127.0.0.1
PORT=8790
DEMO_MODE=true
DATA_DIR=./data
# Generate with: pnpm generate:data-key
ROOTCAUSE_DATA_KEY=
REQUEST_BODY_LIMIT_BYTES=131072
RATE_LIMIT_PER_MINUTE=120

# Optional EVM observer. Localhost is enforced by default.
EVM_RPC_URL=http://127.0.0.1:8545
EVM_EXPECTED_CHAIN_ID=1
EVM_ALLOW_REMOTE_RPC=false
EVM_RPC_TIMEOUT_MS=5000
EVM_RPC_RESPONSE_LIMIT_BYTES=2097152
WATCHTOWER_ENABLED=false
WATCHTOWER_INTERVAL_MS=15000

# Only the Windows desktop launcher sets this to 1. A server deployment must
# never open a browser, and the app refuses to do so on a non-loopback bind.
ROOTCAUSE_OPEN_BROWSER=0
